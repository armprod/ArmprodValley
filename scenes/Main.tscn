[sub_resource type="CSharpScript" id="CSharpScript_rarhs"]
script/source = "using Godot;
using System;

[Tool] // Díky tomuhle to poběží i přímo v editoru
public partial class RandomTileSpawner : TileMapLayer
{
	[Export]
	public int PocetBloku = 50;

	[Export]
	public int IdDlazdice = 1;

	[Export]
	public Vector2I OblastVelikost = new Vector2I(20, 20);

	// Tohle v Inspektoru uvidíš jako zaškrtávací políčko
	[Export]
	public bool SpustitGenerovani {
		get => false;
		set {
			if (value) Generuj();
		}
	}

	public void Generuj()
	{
		Random random = new Random();
		int vygenerovano = 0;

		// Vyčistíme oblast, pokud chceš začít znovu (volitelné)
		// Clear(); 

		while (vygenerovano < PocetBloku)
		{
			int x = random.Next(0, OblastVelikost.X);
			int y = random.Next(0, OblastVelikost.Y);
			Vector2I souradnice = new Vector2I(x, y);

			// Zkontrolujeme, jestli je tam prázdno (SourceId == -1)
			if (GetCellSourceId(souradnice) == -1)
			{
				// Parametry: souradnice, idSetu, souradniceVSetu
				SetCell(souradnice, IdDlazdice, new Vector2I(0, 0));
				vygenerovano++;
			}
		}
		
		GD.Print($\"Hotovo! Vygenerováno {vygenerovano} bloků.\");
	}
}
"

